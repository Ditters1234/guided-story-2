{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guided Story 2",
  "version": "0.1.0",
  "identifier": "com.ditters.guided-story-2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Guided Story 2", "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 720 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
