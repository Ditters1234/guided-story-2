{
  "name": "guided-story-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --fail-on-warnings",
    "test": "vitest run",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "manual:build": "npm run desktop:build && node scripts/package-manual-test.mjs",
    "verify": "npm run check && npm test && npm run native:test && npm run native:check && npm run build",
    "native:test": "node scripts/cargo.mjs test -p story-project",
    "native:check": "node scripts/cargo.mjs check -p guided-story-2",
    "bindings": "node scripts/cargo.mjs run -p guided-story-2 -- --export-bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xyflow/svelte": "^1.7.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
